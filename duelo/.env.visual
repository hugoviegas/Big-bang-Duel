# Visual QA harness only. Loaded by `vite --mode visual` (npm run test:visual).
# Never used by `vite build`: the harness is gated on import.meta.env.DEV.
# Fake Firebase project: the harness disables Firestore/RTDB networking and
# Playwright aborts all non-local requests, so nothing reaches a real backend.
VITE_VISUAL_HARNESS=true
VITE_FIREBASE_API_KEY=visual-harness-fake-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bbd-visual.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-bbd-visual-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-bbd-visual
VITE_FIREBASE_STORAGE_BUCKET=demo-bbd-visual.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_GEMINI_API_KEY=
